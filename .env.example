# Copy to .env (never commit .env). Every value is optional except where noted.

# --- AI content (tried in this order) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b        # 3070 Ti: llama3.1:8b, qwen2.5:7b, gemma2:9b
# OLLAMA_DISABLED=1
GROQ_API_KEY=                   # free tier: console.groq.com
# GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=                 # free tier: aistudio.google.com
# GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=             # free models: openrouter.ai
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Pulling leads to your PC (npm run leads) ---
ADMIN_TOKEN=                    # same value you set in Cloudflare (24+ random chars)
LEAD_APIS=https://your-site.pages.dev,https://another-site.com

# --- Settlement: none | log | koinos ---
SETTLEMENT=none
# KOINOS_RPC=https://api.koinos.io
# KOINOS_OPERATOR_WIF=          # private key — keep secret
# KOINOS_REGISTRY_ID=
