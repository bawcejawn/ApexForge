---
// src/components/LeadForm.astro
// -----------------------------------------------------------------------------
// Multi-step lead form ("online application") generated from the vertical's
// `form.steps`. Field types:
//   select · text · tel · email · zip · number · date · textarea
//   multi   (checkbox group; `none` = an exclusive "None of these" option)
// Field options:
//   required, autocomplete, placeholder, help, half (two per row),
//   min / max / unit (number), showIf: { field, in: [...] } (conditional)
// Hidden (showIf false) fields are disabled, so they're neither validated nor sent.
//
// Compliance:
// - Consent checkbox is UNCHECKED by default and required (TCPA / SC law).
// - The exact consent text shown is posted with the lead and stored as proof.
// - Honeypot + time-on-page catch most bots without a CAPTCHA.
// Posts JSON to /api/lead (Cloudflare Pages Function in /functions).
// -----------------------------------------------------------------------------
import { site, vertical, consentText } from '../lib/site.mjs';

interface Props { service?: string; city?: string; }
const { service, city } = Astro.props;
const consent = consentText();
const steps = vertical.form.steps;
const opts = (f) => f.fromServices ? vertical.services.map(s => ({ v: s.slug, l: s.name })) : (f.options || []).map(o => ({ v: o, l: o }));
const showIf = (f) => (f.showIf ? JSON.stringify(f.showIf) : undefined);
---
<form class="lead card" id="lead-form" novalidate data-site={site.slug}>
  <div class="lead-head">
    <strong>{vertical.cta}</strong>
    <span class="muted step-count">Step <b data-step-now>1</b> of {steps.length}</span>
  </div>
  <div class="progress" aria-hidden="true"><i data-progress style={`width:${100 / steps.length}%`}></i></div>
  {vertical.form.intro && <p class="muted intro">{vertical.form.intro}</p>}

  {steps.map((step, i) => (
    <fieldset data-step={i} hidden={i !== 0}>
      <legend>{step.title}</legend>
      {step.help && <p class="muted step-help">{step.help}</p>}
      <div class="fields">
        {step.fields.map(f => (
          f.type === 'multi' ? (
            <div class="field full multi" data-showif={showIf(f)} data-multi={f.name} data-required={f.required ? '1' : undefined}>
              <span>{f.label}{f.required && <em aria-hidden="true"> *</em>}</span>
              {f.help && <small class="help">{f.help}</small>}
              <div class="checks">
                {opts(f).map(o => (
                  <label class="check"><input type="checkbox" name={f.name} value={o.v} /> {o.l}</label>
                ))}
                {f.none && <label class="check none"><input type="checkbox" name={f.name} value={f.none} data-none /> {f.none}</label>}
              </div>
            </div>
          ) : (
            <label class={`field ${f.half ? 'half' : 'full'}`} data-showif={showIf(f)}>
              <span>{f.label}{f.required && <em aria-hidden="true"> *</em>}</span>
              {f.type === 'select' ? (
                <select name={f.name} required={f.required}>
                  <option value="">Choose one…</option>
                  {opts(f).map(o => <option value={o.v} selected={o.v === service}>{o.l}</option>)}
                </select>
              ) : f.type === 'textarea' ? (
                <textarea name={f.name} required={f.required} rows="2" maxlength="500" placeholder={f.placeholder}></textarea>
              ) : (
                <div class={f.unit ? 'unit-wrap' : undefined}>
                  <input
                    name={f.name}
                    required={f.required}
                    autocomplete={f.autocomplete}
                    placeholder={f.placeholder}
                    type={{ tel: 'tel', email: 'email', number: 'number', date: 'date' }[f.type] || 'text'}
                    inputmode={f.type === 'zip' || f.type === 'number' ? 'numeric' : f.type === 'tel' ? 'tel' : undefined}
                    pattern={f.type === 'zip' ? '\\d{5}' : undefined}
                    maxlength={f.type === 'zip' ? 5 : f.type === 'number' || f.type === 'date' ? undefined : 120}
                    min={f.min}
                    max={f.max}
                  />
                  {f.unit && <b class="unit">{f.unit}</b>}
                </div>
              )}
              {f.help && <small class="help">{f.help}</small>}
            </label>
          )
        ))}
      </div>

      {i === steps.length - 1 && (
        <label class="consent">
          <input type="checkbox" name="consent" value="yes" required />
          <span>{consent} See <a href="/privacy/" target="_blank">Privacy Policy</a> and <a href="/terms/" target="_blank">Terms</a>.</span>
        </label>
      )}

      <div class="actions">
        {i > 0 && <button type="button" class="btn secondary" data-back>Back</button>}
        {i < steps.length - 1
          ? <button type="button" class="btn" data-next>Continue</button>
          : <button type="submit" class="btn">{vertical.cta}</button>}
      </div>
    </fieldset>
  ))}

  <!-- Honeypot: hidden from humans, bots fill it. -->
  <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden">
    <label>Company website <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <input type="hidden" name="city" value={city || ''} />
  <input type="hidden" name="consent_text" value={consent} />
  <p class="form-msg" role="alert" hidden></p>
  <p class="muted small">Free. No obligation. We never ask for your Social Security number or bank details on this form. Your information is shared only with the company named above.</p>
</form>

<style>
  .lead { position: relative; box-shadow: 0 10px 30px rgba(15, 61, 62, .08); }
  .lead-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .progress { height: 4px; background: var(--line); border-radius: 4px; overflow: hidden; margin-bottom: 14px; }
  .progress i { display: block; height: 100%; background: var(--primary); transition: width .25s; }
  .intro, .step-help { font-size: .88rem; margin: -4px 0 12px; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { font-weight: 700; font-size: 1.15rem; margin-bottom: 10px; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; column-gap: 10px; }
  .field { display: block; margin: 0 0 12px; grid-column: 1 / -1; min-width: 0; }
  .field.half { grid-column: auto; }
  .field[hidden] { display: none; }
  .field > span { display: block; font-size: .9rem; font-weight: 600; margin-bottom: 4px; }
  .field em { color: #b3261e; font-style: normal; }
  .field input, .field select, .field textarea { width: 100%; font: inherit; padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: inherit; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: 2px solid var(--primary); outline-offset: 1px; }
  .field .invalid, .multi.invalid .checks { border-color: #b3261e; }
  .help { display: block; color: var(--muted); font-size: .78rem; margin-top: 3px; }
  .unit-wrap { position: relative; }
  .unit-wrap input { padding-right: 44px; }
  .unit { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--muted); font-weight: 600; font-size: .85rem; }
  .checks { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; background: #fff; }
  @media (max-width: 480px) { .checks { grid-template-columns: 1fr; } }
  .check { display: flex; gap: 8px; align-items: flex-start; font-size: .88rem; font-weight: 500; line-height: 1.35; }
  .check input { margin-top: 2px; flex: none; }
  .check.none { grid-column: 1 / -1; border-top: 1px dashed var(--line); padding-top: 6px; font-weight: 600; }
  .consent { display: flex; gap: 10px; font-size: .78rem; line-height: 1.45; color: var(--muted); margin: 8px 0 14px; }
  .consent input { margin-top: 3px; flex: none; width: 18px; height: 18px; }
  .actions { display: flex; gap: 10px; }
  .actions .btn { flex: 1; }
  .form-msg { color: #b3261e; font-weight: 600; }
  .small { font-size: .8rem; margin: 10px 0 0; }
</style>

<script>
  // Plain JS, no framework: steps, conditional fields, validation, submit.
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const started = Date.now();
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-step]')];
  const msg = form.querySelector('.form-msg') as HTMLElement;
  let cur = 0;

  /** Current value(s) of a named field, as an array (handles selects and checkbox groups). */
  const valuesOf = (name: string) => {
    const els = [...form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`)];
    return els.filter(el => (el.type === 'checkbox' ? el.checked : !el.disabled)).map(el => el.value).filter(Boolean);
  };

  /** Show/hide fields with data-showif={"field":"x","in":[...]}. Hidden fields are disabled. */
  const applyConditions = () => {
    form.querySelectorAll<HTMLElement>('[data-showif]').forEach(wrap => {
      const rule = JSON.parse(wrap.dataset.showif!);
      const vals = valuesOf(rule.field);
      const visible = rule.in ? vals.some(v => rule.in.includes(v)) : rule.notIn ? !vals.some(v => rule.notIn.includes(v)) && vals.length > 0 : vals.length > 0;
      wrap.hidden = !visible;
      wrap.querySelectorAll<HTMLInputElement>('input,select,textarea').forEach(el => (el.disabled = !visible));
    });
  };

  // "None of these" is exclusive within its checkbox group.
  form.addEventListener('change', e => {
    const el = e.target as HTMLInputElement;
    if (el.type === 'checkbox' && el.name !== 'consent') {
      const group = [...form.querySelectorAll<HTMLInputElement>(`input[name="${el.name}"]`)];
      if (el.dataset.none !== undefined && el.checked) group.forEach(g => g !== el && (g.checked = false));
      else if (el.checked) group.forEach(g => g.dataset.none !== undefined && (g.checked = false));
    }
    applyConditions();
  });

  const show = (i: number) => {
    steps.forEach((s, j) => (s.hidden = j !== i));
    cur = i;
    (form.querySelector('[data-step-now]') as HTMLElement).textContent = String(i + 1);
    (form.querySelector('[data-progress]') as HTMLElement).style.width = `${((i + 1) / steps.length) * 100}%`;
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  const valid = (fs: HTMLFieldSetElement) => {
    let ok = true;
    const mark = (el: Element, bad: boolean) => {
      el.classList.toggle('invalid', bad);
      if (bad && ok) { (el.querySelector('input') as HTMLElement || el as HTMLElement).focus?.(); ok = false; }
    };
    fs.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input:not([type=checkbox]),select,textarea').forEach(el => {
      if (!el.disabled) mark(el, !el.checkValidity());
    });
    fs.querySelectorAll<HTMLElement>('[data-multi][data-required]').forEach(group => {
      if (!group.hidden) mark(group, valuesOf(group.dataset.multi!).length === 0);
    });
    const c = fs.querySelector<HTMLInputElement>('[name=consent]');
    if (c) mark(c, !c.checked);
    msg.hidden = ok;
    if (!ok) msg.textContent = c && !c.checked ? 'Please check the consent box to continue.' : 'Please complete the highlighted fields.';
    return ok;
  };

  form.addEventListener('click', e => {
    const b = e.target as HTMLElement;
    if (b.matches('[data-next]') && valid(steps[cur])) show(cur + 1);
    if (b.matches('[data-back]')) show(cur - 1);
  });

  form.addEventListener('submit', async e => {
    e.preventDefault();
    if (!valid(steps[cur])) return;
    const data: Record<string, unknown> = {};
    for (const [k, v] of new FormData(form)) {
      // Checkbox groups become arrays; everything else a single string.
      if (form.querySelector(`[data-multi="${k}"]`)) (data[k] = (data[k] as string[]) || []), (data[k] as string[]).push(String(v));
      else data[k] = v;
    }
    const q = new URLSearchParams(location.search);
    for (const k of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'gclid']) if (q.get(k)) data[k] = q.get(k);
    data.site = form.dataset.site;
    data.page_url = location.href;
    data.referrer = document.referrer;
    data._time_on_page_s = Math.round((Date.now() - started) / 1000);
    const btn = form.querySelector('[type=submit]') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Sending…';
    try {
      const res = await fetch('/api/lead', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok) throw new Error(out.error || 'Something went wrong.');
      // Prefill the booking link on the thank-you page (stays in this browser tab only).
      try { sessionStorage.setItem('af_lead', JSON.stringify({ name: `${data.first_name || ''} ${data.last_name || ''}`.trim(), email: data.email || '' })); } catch {}
      location.href = '/thank-you/';
    } catch (err) {
      msg.hidden = false;
      msg.textContent = (err as Error).message + ' Please try again.';
      btn.disabled = false; btn.textContent = 'Try again';
    }
  });

  applyConditions();
</script>
