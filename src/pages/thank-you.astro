---
// Thank-you page. The lead API tells the form who the lead was routed to
// (partner or you); this page names them and shows their booking link, so the
// consumer books a time on the spot. That's the single biggest lift in contact
// rate. Falls back to the site's own booking link (Settings → Booking link).
import Base from '../layouts/Base.astro';
import { site, vertical, vars } from '../lib/site.mjs';
const booking = site.bookingUrl && /^https:\/\//.test(site.bookingUrl) ? site.bookingUrl : '';
const isLife = vertical.id === 'life-insurance';
---
<Base title={`Thank you | ${site.brand}`} description="Your request was received." path="/thank-you/" noindex>
  <div class="wrap prose" style="padding:48px 16px">
    <h1>Thanks, your request is in.</h1>
    <p id="who">A licensed professional from <strong>{vars.buyers}</strong> will reach out shortly{isLife ? ', with your quotes ready' : ''}. Keep your phone handy.</p>
    <div id="book-box" hidden={!booking}>
      <p><strong>Skip the phone tag:</strong> pick a time that works for you. It takes about 15 minutes.</p>
      <p><a class="btn" id="book" href={booking || '#'} target="_blank" rel="noopener">Pick my call time</a></p>
      <p class="muted">Prefer not to schedule? That's fine, we'll reach out within one business day.</p>
    </div>
    <h2>While you wait</h2>
    <ul>
      {isLife ? <>
        <li>Have a list of your medications and your doctor's name handy. It speeds things up if you decide to apply.</li>
        <li>Think about who you'd want as your beneficiary.</li>
      </> : <>
        <li>Jot down your goals, budget and timeline so the conversation is quick.</li>
      </>}
      <li>Check your email for a confirmation with their name.</li>
      <li>There is never any obligation to buy or apply.</li>
    </ul>
    <p><a class="btn secondary" href={`/${vertical.services[0].slug}/`}>Keep reading about {vertical.services[0].name.toLowerCase()}</a></p>
  </div>
  <script>
    // Name the person who'll call and use THEIR booking link. All text is set
    // with textContent (never innerHTML). Data stays in this browser tab.
    try {
      const lead = JSON.parse(sessionStorage.getItem('af_lead') || 'null');
      const c = lead?.contact;
      const who = document.getElementById('who')!;
      if (c?.name) {
        who.replaceChildren(
          'You\'re all set. ',
          Object.assign(document.createElement('strong'), { textContent: c.company ? `${c.name} of ${c.company}` : c.name }),
          ' will contact you shortly' + (c.phone ? ' from ' : '.'),
          ...(c.phone ? [Object.assign(document.createElement('strong'), { textContent: c.phone }), ', so you\'ll know it\'s them.'] : [])
        );
      }
      const a = document.getElementById('book') as HTMLAnchorElement;
      const url = c?.bookingUrl && /^https:\/\//.test(c.bookingUrl) ? c.bookingUrl : a.getAttribute('href');
      if (url && url !== '#') {
        const u = new URL(url);
        if (lead?.name) u.searchParams.set('name', lead.name);   // Cal.com & Calendly prefill
        if (lead?.email) u.searchParams.set('email', lead.email);
        a.href = u.toString();
        document.getElementById('book-box')!.hidden = false;
      }
    } catch {}
  </script>
</Base>
