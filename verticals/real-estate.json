{
  "id": "real-estate",
  "label": "Real Estate",
  "heroTitle": "Buying or selling a home in {{city}}?",
  "heroSub": "Get matched with a top local agent who knows your neighborhood, or get a free home value estimate.",
  "cta": "Get matched",
  "audience": "local homeowners planning to sell and buyers planning a purchase",
  "services": [
    {
      "slug": "sell-my-house",
      "name": "Sell My House",
      "keyword": "sell my house",
      "angle": "homeowners deciding between listing with an agent and selling as-is, wanting a realistic price and timeline",
      "faqs": [
        {
          "q": "How long does it take to sell a house?",
          "a": "It depends on price, condition and local demand. A local agent can show you recent days-on-market for comparable homes nearby."
        }
      ]
    },
    {
      "slug": "home-value",
      "name": "What Is My Home Worth",
      "keyword": "home value estimate",
      "angle": "owners curious about current market value, often 3-12 months from selling",
      "faqs": [
        {
          "q": "How accurate are online home value estimates?",
          "a": "Automated estimates can be off by a wide margin, especially for unique homes. A comparative market analysis from a local agent uses recent nearby sales and the home's condition."
        }
      ]
    },
    {
      "slug": "buy-a-home",
      "name": "Buy a Home",
      "keyword": "buyers agent",
      "angle": "buyers who want a local agent to find, tour and negotiate on homes",
      "faqs": [
        {
          "q": "Who pays the buyer's agent?",
          "a": "Compensation is negotiable and is set out in a written buyer agreement before touring. An agent will explain the options in your market."
        }
      ]
    }
  ],
  "form": {
    "intro": "About 2 minutes. The more you share, the more useful the first conversation will be.",
    "steps": [
      {
        "title": "How can we help?",
        "fields": [
          {
            "name": "service",
            "label": "I want to",
            "type": "select",
            "required": true,
            "fromServices": true
          },
          {
            "name": "timeline",
            "label": "Timeline",
            "type": "select",
            "required": true,
            "options": [
              "ASAP",
              "1-3 months",
              "3-6 months",
              "6-12 months",
              "Just curious"
            ]
          },
          {
            "name": "price_range",
            "label": "Price range / estimated value",
            "type": "select",
            "required": true,
            "options": [
              "Under $200,000",
              "$200,000 - $350,000",
              "$350,000 - $500,000",
              "$500,000 - $800,000",
              "Over $800,000",
              "Not sure"
            ]
          }
        ]
      },
      {
        "title": "Tell us about the home",
        "help": "Answer what applies to you.",
        "fields": [
          {
            "name": "address",
            "label": "Property address",
            "type": "text",
            "required": false,
            "autocomplete": "street-address",
            "showIf": {
              "field": "service",
              "in": [
                "sell-my-house",
                "home-value"
              ]
            }
          },
          {
            "name": "property_type",
            "label": "Property type",
            "type": "select",
            "required": false,
            "options": [
              "Single-family home",
              "Condo",
              "Townhome",
              "Manufactured / mobile home",
              "Land",
              "Multi-family"
            ]
          },
          {
            "name": "beds",
            "label": "Bedrooms",
            "type": "select",
            "required": false,
            "options": [
              "1",
              "2",
              "3",
              "4",
              "5+"
            ],
            "half": true
          },
          {
            "name": "property_use",
            "label": "It is (or will be) my",
            "type": "select",
            "required": false,
            "options": [
              "Primary home",
              "Second / vacation home",
              "Rental or investment"
            ],
            "half": true
          },
          {
            "name": "condition",
            "label": "Condition",
            "type": "select",
            "required": false,
            "options": [
              "Move-in ready",
              "Needs minor updates",
              "Needs major repairs"
            ],
            "showIf": {
              "field": "service",
              "in": [
                "sell-my-house",
                "home-value"
              ]
            }
          },
          {
            "name": "sell_reason",
            "label": "Reason for selling",
            "type": "select",
            "required": false,
            "options": [
              "Relocating",
              "Downsizing",
              "Upsizing",
              "Inherited property",
              "Financial reasons",
              "Selling an investment",
              "Other"
            ],
            "showIf": {
              "field": "service",
              "in": [
                "sell-my-house",
                "home-value"
              ]
            }
          },
          {
            "name": "listed",
            "label": "Is it listed with an agent now?",
            "type": "select",
            "required": false,
            "options": [
              "No",
              "Yes, currently listed",
              "It was listed but expired"
            ],
            "showIf": {
              "field": "service",
              "in": [
                "sell-my-house",
                "home-value"
              ]
            }
          },
          {
            "name": "areas",
            "label": "Areas you're considering",
            "type": "text",
            "required": false,
            "placeholder": "e.g. Carolina Forest, Conway, Surfside",
            "showIf": {
              "field": "service",
              "in": [
                "buy-a-home"
              ]
            }
          },
          {
            "name": "financing",
            "label": "How will you pay?",
            "type": "select",
            "required": false,
            "options": [
              "Pre-approved for a mortgage",
              "Need a mortgage, not pre-approved yet",
              "Paying cash"
            ],
            "showIf": {
              "field": "service",
              "in": [
                "buy-a-home"
              ]
            }
          },
          {
            "name": "must_sell_first",
            "label": "Do you need to sell a home first?",
            "type": "select",
            "required": false,
            "options": [
              "No",
              "Yes"
            ],
            "showIf": {
              "field": "service",
              "in": [
                "buy-a-home"
              ]
            }
          },
          {
            "name": "has_agent",
            "label": "Are you working with an agent?",
            "type": "select",
            "required": false,
            "options": [
              "No",
              "Yes"
            ],
            "showIf": {
              "field": "service",
              "in": [
                "buy-a-home"
              ]
            }
          }
        ]
      },
      {
        "title": "Who should we contact?",
        "fields": [
          {
            "name": "first_name",
            "label": "First name",
            "type": "text",
            "required": true,
            "autocomplete": "given-name",
            "half": true
          },
          {
            "name": "last_name",
            "label": "Last name",
            "type": "text",
            "required": true,
            "autocomplete": "family-name",
            "half": true
          },
          {
            "name": "phone",
            "label": "Mobile phone",
            "type": "tel",
            "required": true,
            "autocomplete": "tel",
            "half": true
          },
          {
            "name": "zip",
            "label": "ZIP code",
            "type": "zip",
            "required": true,
            "autocomplete": "postal-code",
            "half": true
          },
          {
            "name": "email",
            "label": "Email",
            "type": "email",
            "required": true,
            "autocomplete": "email"
          },
          {
            "name": "best_time",
            "label": "Best time to reach you",
            "type": "select",
            "required": false,
            "options": [
              "Weekday mornings",
              "Weekday lunch",
              "Weekday evenings",
              "Weekends",
              "Anytime"
            ]
          }
        ]
      }
    ]
  },
  "scoring": {
    "rules": [
      {
        "field": "timeline",
        "in": [
          "ASAP",
          "1-3 months"
        ],
        "points": 30
      },
      {
        "field": "timeline",
        "in": [
          "3-6 months"
        ],
        "points": 15
      },
      {
        "field": "service",
        "in": [
          "sell-my-house",
          "home-value"
        ],
        "points": 10
      },
      {
        "field": "address",
        "present": true,
        "points": 10
      },
      {
        "field": "financing",
        "in": [
          "Pre-approved for a mortgage",
          "Paying cash"
        ],
        "points": 10
      },
      {
        "field": "listed",
        "in": [
          "Yes, currently listed"
        ],
        "points": -20
      },
      {
        "field": "has_agent",
        "in": [
          "Yes"
        ],
        "points": -20
      },
      {
        "field": "_phone_valid",
        "in": [
          true
        ],
        "points": 20
      },
      {
        "field": "_email_freemail_disposable",
        "in": [
          true
        ],
        "points": -40
      }
    ],
    "tiers": {
      "A": 70,
      "B": 45
    },
    "suggestedPrice": {
      "A": 80,
      "B": 40,
      "C": 10
    }
  },
  "compliance": {
    "regulator": "state real estate commission",
    "notAProvider": "{{brand}} is not a real estate brokerage. We connect you with licensed local real estate agents. Home value estimates are not appraisals.",
    "contentRules": [
      "Never guarantee a sale price or timeline.",
      "Fair Housing: never describe neighborhoods by the people who live there (race, religion, family status, etc.). Describe homes, amenities and commutes only.",
      "Use 'Equal Housing Opportunity' in the footer."
    ]
  },
  "schemaType": "Organization",
  "callChecklist": [
    "Confirm property address (sellers) or target areas (buyers)",
    "Timeline and what is driving it (job, family, retirement, financial)",
    "Sellers: rough mortgage balance owed, repairs needed, occupied or vacant",
    "Buyers: pre-approval status, price ceiling, must-haves",
    "Are they under contract with another agent? If yes, do not introduce your partner",
    "Best way and time for your partner agent to reach them",
    "Get a clear OK to introduce your partner by name"
  ]
}
